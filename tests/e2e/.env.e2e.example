# Copy to .env.e2e.local. Leave secrets and passwords out of this file.
E2E_TARGET_ENV=staging
E2E_UI_BASE_URL=
E2E_API_BASE_URL=
E2E_PRODUCTION_HOSTS=opstrax.vercel.app,osptrax-fleet-management.onrender.com
E2E_STAGING_HOSTS=

# Browser storage states are sensitive and must live under playwright/.auth/.
# Use a {worker} placeholder when parallel workers need isolated accounts.
E2E_TENANT_AUTH_STATE=
E2E_DRIVER_AUTH_STATE=
E2E_CUSTOMER_AUTH_STATE=
E2E_PLATFORM_AUTH_STATE=

# Mutation tests are disabled unless every guard below is explicitly satisfied.
E2E_ALLOW_STAGING_MUTATIONS=false
E2E_DISPOSABLE_TENANT_ACK=
E2E_CANARY_VEHICLE_ID=
E2E_TEST_PREFIX=QA-E2E
