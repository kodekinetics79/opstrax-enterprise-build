{
  "name": "opstrax-launch-e2e",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "test:guard": "node --test guard/*.test.mjs",
    "test:list": "playwright test --list",
    "test:public": "playwright test --project=public-chromium",
    "test:local": "playwright test --project=public-chromium",
    "test:staging:readonly": "E2E_TARGET_ENV=staging playwright test --grep @readonly",
    "test:staging:mutations": "E2E_TARGET_ENV=staging playwright test --project=staging-mutations"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
