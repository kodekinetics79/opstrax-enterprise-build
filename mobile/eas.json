{
  "cli": {
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "node": "20.19.4",
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_STAGE": "development",
        "EXPO_PUBLIC_APP_VARIANT": "unified"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-driver": {
      "node": "20.19.4",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_STAGE": "preview",
        "EXPO_PUBLIC_APP_VARIANT": "driver"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-fleet": {
      "node": "20.19.4",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_STAGE": "preview",
        "EXPO_PUBLIC_APP_VARIANT": "fleet"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-customer": {
      "node": "20.19.4",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_STAGE": "preview",
        "EXPO_PUBLIC_APP_VARIANT": "customer"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-driver": {
      "node": "20.19.4",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_STAGE": "production",
        "EXPO_PUBLIC_APP_VARIANT": "driver"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-fleet": {
      "node": "20.19.4",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_STAGE": "production",
        "EXPO_PUBLIC_APP_VARIANT": "fleet"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-customer": {
      "node": "20.19.4",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_STAGE": "production",
        "EXPO_PUBLIC_APP_VARIANT": "customer"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "testflight-driver": {
      "node": "20.19.4",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_STAGE": "preview",
        "EXPO_PUBLIC_APP_VARIANT": "driver",
        "EXPO_PUBLIC_IOS_BUNDLE_ID": "com.kodekinetics.opstrax.driver",
        "EXPO_PUBLIC_API_BASE_URL": "https://osptrax-fleet-management.onrender.com",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "7debd06f-db2d-4c79-848b-d44e84d373a1"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production-driver": {},
    "production-fleet": {},
    "production-customer": {}
  }
}
