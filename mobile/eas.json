{
  "cli": {
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "node": "20.19.4",
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_STAGE": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "node": "20.19.4",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_STAGE": "preview"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "20.19.4",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_STAGE": "production"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
